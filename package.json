{
  "name": "neustand-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:e2e",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --config config/playwright.config.ts",
    "test:a11y": "node node_modules/@playwright/test/cli.js test --config config/playwright.config.ts --grep @a11y",
    "lighthouse:ci": "node config/run-lighthouse-ci.mjs",
    "security:osv": "powershell -NoProfile -ExecutionPolicy Bypass -File config/run-osv-scanner.ps1 scan source --lockfile package-lock.json"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "^0.4.0",
    "dialkit": "2.0.2",
    "lucide-react": "^1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@upstash/context7-mcp": "4.1.2",
    "daisyui": "5.7.47",
    "eslint": "10.12.0",
    "next-devtools-mcp": "0.4.0",
    "originkit": "0.2.25",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "basic-ftp": "6.2.1",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
